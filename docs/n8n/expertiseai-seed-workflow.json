      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst summary = { ok: true, createdAreas: 0, createdCategories: 0, createdDocuments: 0 };\nfor (const item of items) {\n  if (item.json.kind === 'taxonomy') {\n    summary.createdAreas = item.json.createdAreas || 0;\n    summary.createdCategories = item.json.createdCategories || 0;\n  }\n  if (item.json.kind === 'documents') {\n    summary.createdDocuments = item.json.createdDocuments || 0;\n  }\n}\nreturn [{ json: summary }];"
      }
    }
