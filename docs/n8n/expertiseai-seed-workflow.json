        "jsCode": "const response = $input.first().json;\nconst statusCode = Number(response.statusCode || 0);\nconst detail = typeof response.body === 'string' ? response.body : JSON.stringify(response.body || {});\nif (statusCode >= 400) {\n  throw new Error('Create Document failed: HTTP ' + statusCode + ' ' + detail);\n}\nreturn [{ json: { kind: 'document_progress' } }];"
