      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const config = $input.first().json;\nconst totalAreas = Math.max(1, Number(config.areas || 1));\nconst categoriesPerArea = Math.max(1, Number(config.categoriesPerArea || 1));\nconst items = [];\nfor (let i = 0; i < totalAreas; i += 1) {\n  const area = 'Area ' + (i + 1);\n  const categoryNames = [];\n  for (let j = 0; j < categoriesPerArea; j += 1) {\n    categoryNames.push('Categoria ' + (i + 1) + '-' + (j + 1));\n  }\n  items.push({ json: { baseUrl: config.baseUrl, companyId: config.companyId, accessToken: config.access_token, area, categoryNames } });\n}\nreturn items;"
      }
