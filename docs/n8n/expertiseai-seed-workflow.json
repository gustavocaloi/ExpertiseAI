    {
      "id": "432708c7-5d11-4200-ae83-7cfc051a5aa9",
      "name": "Build Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        800
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const config = $input.first().json;\nfunction validityDate(index) {\n  const date = new Date();\n  date.setUTCDate(date.getUTCDate() + (index % 60));\n  return date.toISOString().slice(0, 10);\n}\nfunction pickTag(area) {\n  return String(area).toLowerCase().split(' ').filter(Boolean).join('-');\n}\nfunction createSeededRandom(seed) {\n  let state = seed >>> 0;\n  return () => {\n    state = (state * 1664525 + 1013904223) >>> 0;\n    return state / 0x100000000;\n  };\n}\nfunction randomCode(rand, usedCodes) {\n  while (true) {\n    const partA = Math.floor(rand() * 0xFFFFFFFF).toString(36).padStart(7, '0');\n    const partB = Math.floor(rand() * 0xFFFFFFFF).toString(36).padStart(7, '0');\n    const code = 'COD-' + (partA + partB).slice(0, 12).toUpperCase();\n    if (!usedCodes.has(code)) {\n      usedCodes.add(code);\n      return code;\n    }\n  }\n}\nconst rand = createSeededRandom((Number(config.seed || 42) ^ Date.now()) >>> 0);\nconst totalAreas = Math.max(1, Number(config.areas || 1));\nconst categoriesPerArea = Math.max(1, Number(config.categoriesPerArea || 1));\nconst totalDocs = Math.max(0, Number(config.documents || 0));\nconst newline = String.fromCharCode(10);\nconst categories = [];\nfor (let i = 0; i < totalAreas; i += 1) {\n  const area = 'Area ' + (i + 1);\n  for (let j = 0; j < categoriesPerArea; j += 1) {\n    categories.push({ area, categoria: 'Categoria ' + (i + 1) + '-' + (j + 1) });\n  }\n}\nconst usedCodes = new Set();\nconst items = [];\nfor (let i = 0; i < totalDocs; i += 1) {\n  const selection = categories[i % categories.length];\n  const code = randomCode(rand, usedCodes);\n  const title = 'Documento ' + (i + 1) + ' [' + code + '] - ' + selection.area + '/' + selection.categoria;\n  items.push({\n    json: {\n      baseUrl: config.baseUrl,\n      companyId: config.companyId,\n      accessToken: config.access_token,\n      area: selection.area,\n      categoria: selection.categoria,\n      title,\n      randomCode: code,\n      content: ['# ' + title, '', 'Conteudo gerado automaticamente para testes.', ''].join(newline),\n      tags: ['seed', pickTag(selection.area)],\n      publicar: Boolean(config.publish),\n      data_validade: validityDate(i)\n    }\n  });\n}\nreturn items;"
      }
    },
