      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nconst source = $('Area Loop').first().json;\nconst statusCode = Number(response.statusCode || 0);\nconst detail = typeof response.body === 'string' ? response.body : JSON.stringify(response.body || {});\nif (statusCode >= 400 && !detail.includes('exist') && !detail.includes('já')) {\n  throw new Error('Create Area failed: HTTP ' + statusCode + ' ' + detail);\n}\nreturn [{ json: { ...source, areaResponse: response.body, areaStatusCode: statusCode } }];"
