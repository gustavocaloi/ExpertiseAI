    {
      "id": "9782dce5-63fc-435a-8047-f4019a0e2f0a",
      "name": "Validate Categories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2384,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const responses = $input.all();\nfor (const responseItem of responses) {\n  const response = responseItem.json;\n  const statusCode = Number(response.statusCode || 0);\n  const detail = typeof response.body === 'string' ? response.body : JSON.stringify(response.body || {});\n  if (statusCode >= 400 && !detail.includes('exist') && !detail.includes('já')) {\n    throw new Error('Create Category failed: HTTP ' + statusCode + ' ' + detail);\n  }\n}\nreturn [{ json: { kind: 'taxonomy_progress' } }];"
      }
    },
    {
      "id": "8f5cb616-a2ae-4d77-8042-8713efe0df96",
      "name": "Area Loop",
      "type": "n8n-nodes-base.splitInBatches",
